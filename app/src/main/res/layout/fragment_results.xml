<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Election Results"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textAlignment="center"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textResultsSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_rounded"
            android:padding="16dp"
            android:layout_marginBottom="16dp"
            android:text="Loading..." />

        <com.github.mikephil.charting.charts.PieChart
            android:id="@+id/pieChartResults"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="8dp" />

        <com.github.mikephil.charting.charts.BarChart
            android:id="@+id/barChartResults"
            android:layout_width="match_parent"
            android:layout_height="300dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_card_rounded"
            android:padding="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonExportResults"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Detailed PDF Report"
            android:layout_marginBottom="16dp"
            app:icon="@android:drawable/ic_menu_save" />

        <TextView
            android:id="@+id/textDashboardTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Live Voting Dashboard"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="8dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerVotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>
</ScrollView>
