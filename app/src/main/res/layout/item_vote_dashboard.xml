<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:foreground="?attr/selectableItemBackground"
    app:cardUseCompatPadding="true"
    app:cardCornerRadius="12dp"
    app:cardElevation="3dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <ImageView
            android:id="@+id/imageVoteDashboardGender"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:src="@drawable/ic_candidate_male"
            android:layout_gravity="start"
            android:layout_marginBottom="8dp" />

        <TextView
            android:id="@+id/textVoteStudent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Student: 12345"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textVoteCandidate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Candidate: Candidate A"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/textVoteTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Time: 2025-01-01 12:00"
            android:paddingTop="2dp" />

        <TextView
            android:id="@+id/textVoteFeedback"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Feedback: "
            android:paddingTop="4dp"
            android:textStyle="italic"
            android:textColor="@color/color_on_surface" />

    </LinearLayout>

</androidx.cardview.widget.CardView>
